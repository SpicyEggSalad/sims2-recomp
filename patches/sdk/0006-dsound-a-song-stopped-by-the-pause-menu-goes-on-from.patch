+// A wave bank (XWB, the game's audiostr.xwb) holds every song one after the other, and a song's packets are read on
+// from where it starts. Where the song stops is in the bank's table of entries: each one is a play region, an offset
+// from the start of the wave data and a length.
+struct BankEntry {
+    uint64_t begin, end;  // in the file
+};
+std::map<std::string, std::vector<BankEntry>> g_banks;
+
+static uint64_t SongEnd(const std::string& path, uint64_t at) {
+    auto it = g_banks.find(path);
+    if (it == g_banks.end()) {
+        std::vector<BankEntry> list;
+        std::ifstream in(std::filesystem::path(path), std::ios::binary);
+        std::vector<uint8_t> h(0x2000);
+        in.read(reinterpret_cast<char*>(h.data()), std::streamsize(h.size()));
+        h.resize(size_t(in.gcount()));
+        auto u32 = [&](size_t o) { return o + 4 <= h.size() ? uint32_t(h[o]) | uint32_t(h[o + 1]) << 8 | uint32_t(h[o + 2]) << 16 | uint32_t(h[o + 3]) << 24 : 0u; };
+        if (h.size() > 0x60 && std::memcmp(h.data(), "WBND", 4) == 0 && u32(4) == 2) {
+            const uint32_t bank = u32(8), meta = u32(16), wave = u32(32);
+            const uint32_t count = u32(bank + 4), size = u32(bank + 0x18);
+            for (uint32_t i = 0; i < count && size >= 16; i++) {
+                const size_t e = size_t(meta) + size_t(i) * size;
+                if (e + 16 > h.size()) break;
+                list.push_back({uint64_t(wave) + u32(e + 8), uint64_t(wave) + u32(e + 8) + u32(e + 12)});
+            }
+        }
+        LOGI("dsound: wave bank %s: %u entries", path.c_str(), unsigned(list.size()));
+        it = g_banks.emplace(path, std::move(list)).first;
+    }
+    for (const BankEntry& e : it->second)
+        if (at >= e.begin && at < e.end) return e.end;
+    return 0;
+}
+
 #define STREAM(name, nargs)                                     \
     static uint32_t str_##name(Voice& v, const Args& a);        \
     HLE_STDCALL(CDirectSoundStream_##name, nargs) {             \
@@ -855,6 +963,7 @@ static void FlushStream(Voice& v) {
 
 STREAM(AddRef, 1) { return uint32_t(++v.refs); }
 STREAM(SetFormat, 2) {
+    LOG_FIRST(3000, "dsound: stream %08X SetFormat, queued=%u", v.obj, unsigned(v.packets.size()));
     FlushStream(v);
     ReadFormat(v, a[1]);
     v.freq = 0;  // the XDK sets the pitch back to the new format's own rate
@@ -862,8 +971,38 @@ STREAM(SetFormat, 2) {
     return 0;
 }
 STREAM(Release, 1) {
+    LOG_FIRST(3000, "dsound: stream %08X Release, refs now %d, queued=%u", v.obj, v.refs - 1, unsigned(v.packets.size()));
     if (--v.refs > 0) return uint32_t(v.refs);
+    if (v.pause_music && g_after_pause == 2) g_after_pause = 3;
+    // let go on its last packet, not by the pause menu: that packet is let play out
+    if (v.stream && !v.was_paused && !v.paused && v.packets.size() == 1) {
+        Voice g = v;
+        g.callback = 0;
+        g.context = 0;
+        g.refs = 0;
+        g.block = -1;
+        g.cache.reset();
+        for (uint32_t& slot : g.sub_slots) slot = 0;
+        for (Packet& pk : g.packets) {
+            const uint32_t blk = mem::AllocSystem(pk.size);
+            std::memcpy(HostPtr(blk), HostPtr(pk.data), pk.size);
+            pk.data = blk;
+            pk.completed_ptr = pk.status_ptr = pk.context = 0;
+            g.ghost_blocks.push_back(blk);
+        }
+        g_ghosts.push_back(std::move(g));
+    }
+    if (v.was_paused && v.has_first && v.cache && !v.cache->empty()) {
+        g_resume.clear();
+        g_resume[v.first_hash] = {v.consumed, std::chrono::steady_clock::now(), v.cache, v.tag, v.channels, v.rate, v.src_ok, v.src, v.src_off, v.src_size};
+        g_last_key = v.first_hash;
+        g_after_pause = 1;
+        g_after_pause_at = std::chrono::steady_clock::now();
+        LOGI("dsound: stream %08X was stopped by the pause menu after %u packets, kept for the restart", v.obj, v.consumed);
+    }
     FlushStream(v);
+    for (uint32_t slot : v.sub_slots)
+        if (slot) mem::FreeSystem(slot);
     uint32_t obj = v.obj;
     g_voices.erase(obj);
     mem::FreeSystem(obj);
@@ -888,29 +1027,118 @@ STREAM(Process, 3) {
     Packet pk{R32(in), R32(in + 4), R32(in + 8), R32(in + 12), R32(in + 16)};
     g_stat_process++;
     g_stat_process_bytes += pk.size;
-    LOG_FIRST(24, "dsound: process #%llu obj=%08X data=%08X size=%u tag=%X ch=%u rate=%u queued=%u", (unsigned long long)g_stat_process, v.obj, pk.data, pk.size, v.tag, v.channels, v.rate, unsigned(v.packets.size()) + 1);
+    uint32_t fp = 2166136261u; { const uint8_t* hp = static_cast<const uint8_t*>(HostPtr(pk.data)); for (uint32_t i = 0; i < pk.size; i++) fp = (fp ^ hp[i]) * 16777619u; }
+    LOG_FIRST(4000, "dsound: process #%llu obj=%08X data=%08X size=%u tag=%X ch=%u rate=%u queued=%u hash=%08X", (unsigned long long)g_stat_process, v.obj, pk.data, pk.size, v.tag, v.channels, v.rate, unsigned(v.packets.size()) + 1, fp);
     if (pk.completed_ptr) W32(pk.completed_ptr, 0);
     if (pk.status_ptr) W32(pk.status_ptr, kPacketPending);
+    if (!v.sub) {
+        if (!v.cache) v.cache = std::make_shared<std::vector<std::vector<uint8_t>>>();
+        std::string path;
+        uint64_t pos = 0;
+        const bool found = kernel::FindRead(pk.data, pk.size, path, pos);
+        const size_t index = v.cache->size();
+        if (index == 0) {
+            v.src_ok = found;
+            v.src = path;
+            v.src_off = pos;
+            v.src_size = pk.size;
+            LOGI("dsound: stream %08X first packet is %s from %s at %llu", v.obj, found ? "read" : "not read", found ? path.c_str() : "?", (unsigned long long)pos);
+        } else if (v.src_ok && (!found || path != v.src || pk.size != v.src_size || pos != v.src_off + index * v.src_size)) {
+            v.src_ok = false;
+            LOGI("dsound: stream %08X packet %u does not follow the one before in the file", v.obj, unsigned(index));
+        }
+        if (v.cache->size() < 800) {
+            const uint8_t* hp = static_cast<const uint8_t*>(HostPtr(pk.data));
+            v.cache->emplace_back(hp, hp + pk.size);
+        }
+    }
+    if (!v.has_first) {
+        v.has_first = true;
+        v.first_hash = fp;
+        auto it = g_resume.find(fp);
+        if (it != g_resume.end()) {
+            if (std::chrono::steady_clock::now() - it->second.at < std::chrono::minutes(30)) {
+                v.skip = it->second.consumed;
+                LOGI("dsound: stream %08X is a song stopped by the pause menu: skipping its first %u packets", v.obj, v.skip);
+            }
+            g_resume.erase(it);
+        } else if (v.candidate) {
+            auto old = g_resume.find(g_last_key);
+            if (old != g_resume.end() && old->second.cache && (old->second.src_ok || old->second.consumed < old->second.cache->size()) &&
+                old->second.tag == v.tag && old->second.channels == v.channels && old->second.rate == v.rate &&
+                std::chrono::steady_clock::now() - old->second.at < std::chrono::minutes(30)) {
+                v.sub = true;
+                v.cache = old->second.cache;
+                v.first_hash = g_last_key;
+                v.sub_next = v.consumed = old->second.consumed;
+                v.src_ok = old->second.src_ok;
+                v.src = old->second.src;
+                v.src_off = old->second.src_off;
+                v.src_size = old->second.src_size;
+                LOGI("dsound: stream %08X is another song after the pause menu: playing the stopped one again from packet %u of %u", v.obj, v.sub_next, unsigned(v.cache->size()));
+                g_resume.erase(old);
+            }
+        }
+    }
+    if (v.sub) {
+        // the stopped song's next packet: kept, or read from the game's file where the old stream left off
+        std::vector<uint8_t> got;
+        if (v.sub_next < v.cache->size()) {
+            got = (*v.cache)[v.sub_next];
+        } else if (v.src_ok && v.src_size) {
+            const uint64_t at = v.src_off + uint64_t(v.sub_next) * v.src_size, end = SongEnd(v.src, v.src_off);
+            if (end > at) {
+                std::ifstream in(std::filesystem::path(v.src), std::ios::binary);
+                got.resize(size_t(std::min<uint64_t>(v.src_size, end - at)));
+                in.seekg(std::streamoff(at));
+                in.read(reinterpret_cast<char*>(got.data()), std::streamsize(got.size()));
+                got.resize(size_t(std::max<std::streamsize>(in.gcount(), 0)));
+            }
+        }
+        if (got.empty()) {  // the stopped song is over: let the game's own run out quickly
+            v.consumed++;
+            Complete(v, pk, 0);
+            return 0;
+        }
+        v.sub_next++;
+        if (!v.sub_slots[0])
+            for (uint32_t& slot : v.sub_slots) slot = mem::AllocSystem(std::max<uint32_t>(pk.size, 0x40000));
+        const uint32_t slot = v.sub_slots[v.sub_ring++ % 8];
+        std::memset(HostPtr(slot), 0, pk.size);
+        std::memcpy(HostPtr(slot), got.data(), std::min<size_t>(got.size(), pk.size));
+        pk.data = slot;
+    }
+    if (v.skip > 0) {
+        v.skip--;
+        v.consumed++;
+        Complete(v, pk, 0);
+        return 0;
+    }
     v.packets.push_back(pk);
     v.active = true;
     v.ending = false;
     return 0;
 }
 STREAM(Discontinuity, 1) {
+    LOG_FIRST(3000, "dsound: stream %08X Discontinuity, queued=%u active=%d", v.obj, unsigned(v.packets.size()), int(v.active));
     if (!v.packets.empty()) v.ending = true;
     else if (v.active) FlushStream(v);
     return 0;
 }
 STREAM(Flush, 1) {
+    LOG_FIRST(3000, "dsound: stream %08X Flush, queued=%u active=%d", v.obj, unsigned(v.packets.size()), int(v.active));
     FlushStream(v);
     return 0;
 }
 STREAM(FlushEx, 4) {
+    LOG_FIRST(3000, "dsound: stream %08X FlushEx(%u,%u,%u), queued=%u active=%d", v.obj, a[1], a[2], a[3], unsigned(v.packets.size()), int(v.active));
     if (a[3] && !v.active) return 0;
     FlushStream(v);
     return 0;
 }
 STREAM(Pause, 2) {
+    LOG_FIRST(3000, "dsound: stream %08X Pause(%u), queued=%u", v.obj, a[1], unsigned(v.packets.size()));
+    v.was_paused = a[1] == 1;
     v.paused = a[1] == 1;
     v.sync = a[1] == 2;
     return 0;
