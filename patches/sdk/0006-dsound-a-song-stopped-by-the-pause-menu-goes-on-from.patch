--- a/runtime/kernel/files.cpp
+++ b/runtime/kernel/files.cpp
@@ -2,10 +2,13 @@
 #include <cctype>
 #include <chrono>
 #include <cstdio>
+#include <deque>
 #include <ctime>
 #include <filesystem>
 #include <fstream>
 #include <map>
+#include <mutex>
+#include <string>
 
 #include "kernel/disc.h"
 #include "kernel/kernel.h"
