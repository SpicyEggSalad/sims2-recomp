     return o >= 0 ? uint64_t(o) : f.pos;
 }
 
+// The big reads the title made lately (a song is read in packets), so the audio code can tell where a packet came
+// from in the game's files: which file, and from which byte.
+struct ReadNote {
+    uint32_t buf, len;
+    uint64_t pos;
+    std::string path;
+};
+static std::mutex g_notes_lock;
+static std::deque<ReadNote> g_notes;
+
+bool FindRead(uint32_t at, uint32_t size, std::string& path, uint64_t& pos) {
+    std::lock_guard<std::mutex> lock(g_notes_lock);
+    for (auto it = g_notes.rbegin(); it != g_notes.rend(); ++it) {
+        if (at >= it->buf && uint64_t(at) + size <= uint64_t(it->buf) + it->len) {
+            path = it->path;
+            pos = it->pos + (at - it->buf);
+            return true;
+        }
+    }
+    return false;
+}
+
 // pages is the FILE_SEGMENT_ELEMENT array for scatter and gather, 0 for one buffer
 static uint32_t Transfer(const Args& a, bool write, uint32_t pages) {
     uint32_t h = a[0], event = a[1], apc = a[2], apc_ctx = a[3], iosb = a[4], buf = a[5], len = a[6], off = a[7];
@@ -551,6 +576,11 @@ static uint32_t Transfer(const Args& a, bool write, uint32_t pages) {
     f->pos = pos + n;
     if (write && n < len) return Finish(*f, 0xC000007F, n, event, apc, apc_ctx, iosb);  // disk full
     if (!write && len && !n) return Finish(*f, kEndOfFile, 0, event, apc, apc_ctx, iosb);
+    if (!write && !pages && !f->entry && n >= 0x8000) {
+        std::lock_guard<std::mutex> notes(g_notes_lock);
+        g_notes.push_back({buf, n, pos, f->host.string()});
+        if (g_notes.size() > 64) g_notes.pop_front();
+    }
     return Finish(*f, kSuccess, n, event, apc, apc_ctx, iosb);
 }
 
