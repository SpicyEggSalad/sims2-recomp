 // bytes per row of a 32 bit surface in guest memory, rounded to 64
 uint32_t GuestPitch(uint32_t width) { return (width * 4 + 63) & ~63u; }
 
-// A read-back writes GuestPitch(gw) rows of gh into guest memory. Targets are found by address alone, so a smaller
+// the 16 bit colour formats a target is read back into, linear and swizzled: R5G6B5, A1R5G5B5, X1R5G5B5, A4R4G4B4
+bool Packed16(uint32_t fmt) {
+    switch (fmt) {
+        case 0x02: case 0x03: case 0x04: case 0x05: case 0x10: case 0x11: case 0x1C: case 0x1D: return true;
+        default: return false;
+    }
+}
+
+// a BGRA pixel in a 16 bit console colour, the layouts Texel decodes
+uint16_t Pack16(uint32_t fmt, const uint8_t* p) {
+    uint32_t b = p[0], g = p[1], r = p[2], a = p[3];
+    switch (fmt) {
+        case 0x05: case 0x11: return uint16_t((r >> 3) << 11 | (g >> 2) << 5 | b >> 3);
+        case 0x04: case 0x1D: return uint16_t((a >> 4) << 12 | (r >> 4) << 8 | (g >> 4) << 4 | b >> 4);
+        case 0x03: case 0x1C: return uint16_t((r >> 3) << 10 | (g >> 3) << 5 | b >> 3);
+        default: return uint16_t((a >= 128 ? 0x8000u : 0u) | (r >> 3) << 10 | (g >> 3) << 5 | b >> 3);  // A1R5G5B5
+    }
+}
+
+// h BGRA rows src_pitch apart as a surface of fmt holds them: rows of w * bpp bytes, back to back
+std::vector<uint8_t> GuestRows(const uint8_t* src, uint32_t src_pitch, uint32_t w, uint32_t h, uint32_t fmt, uint32_t bpp) {
+    std::vector<uint8_t> out(size_t(w) * h * bpp);
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t* s = src + size_t(y) * src_pitch;
+        uint8_t* d = &out[size_t(y) * w * bpp];
+        if (bpp == 4) {
+            std::memcpy(d, s, size_t(w) * 4);
+            continue;
+        }
+        for (uint32_t x = 0; x < w; x++) {
+            uint16_t v = Pack16(fmt, s + x * 4);
+            std::memcpy(d + x * 2, &v, 2);
+        }
+    }
+    return out;
+}
